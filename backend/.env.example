# Copia este archivo a .env para desarrollo local. NUNCA subas .env a git.
# En Azure App Service estas variables se configuran en: Configuration > Application settings.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL (local o Azure Database for PostgreSQL)
POSTGRES_DB=saas_inscripciones
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# En Azure usar: require
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# CORS: orígenes del frontend permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=False

# DRF
API_PAGE_SIZE=25

# Producción (Azure)
# DJANGO_SECURE_SSL_REDIRECT=False   # App Service ya fuerza HTTPS con "HTTPS Only"
# DJANGO_SECURE_HSTS_SECONDS=0
